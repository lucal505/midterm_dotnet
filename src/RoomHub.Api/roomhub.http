### RoomHub API: contract + business rules R1-R10
# JetBrains HTTP Client (Rider). Start the app (dotnet run, port 5090), then
# "Run All Requests in File". Each request has assertions: see the Tests tab.
# Every run creates new rooms and new people (prefixed with a run id), so the file
# can be run many times against the same SQLite database without R7/R9 collisions.
# All dates are in 2030+, so R5 ("not in the past") never interferes.

@baseUrl = http://localhost:5090

############################################################################
# ROOMS
############################################################################

### 1. Create room (capacity 5) -> 201 + Location + { id, name, capacity }
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 1",
  "capacity": 5
}

> {%
    client.global.set("run", Date.now().toString(36));
    client.global.set("roomId", response.body.id);
    client.test("201 Created with Location and body", () => {
        client.assert(response.status === 201, "expected 201, got " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/rooms/" + response.body.id, "wrong Location");
        client.assert(response.body.name === "Study room 1", "wrong name");
        client.assert(response.body.capacity === 5, "wrong capacity");
    });
%}

### 2. Create large room (capacity 11, R10: max 2h)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Big hall",
  "capacity": 11
}

> {%
    client.global.set("bigRoomId", response.body.id);
    client.test("201 Created", () => client.assert(response.status === 201, "got " + response.status));
%}

### 3. Create room with capacity exactly 10 (R10 boundary: keeps the 4h limit)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Room ten",
  "capacity": 10
}

> {%
    client.global.set("tenRoomId", response.body.id);
    client.test("201 Created", () => client.assert(response.status === 201, "got " + response.status));
%}

### 4. Get room -> 200 { id, name, capacity }
GET {{baseUrl}}/api/rooms/{{roomId}}

> {%
    client.test("200 with room", () => {
        client.assert(response.status === 200, "got " + response.status);
        client.assert(response.body.id === client.global.get("roomId"), "wrong id");
        client.assert(response.body.name === "Study room 1", "wrong name");
        client.assert(response.body.capacity === 5, "wrong capacity");
    });
%}

### 5. Get missing room -> 404 ProblemDetails
GET {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001

> {%
    client.test("404 problem+json", () => {
        client.assert(response.status === 404, "got " + response.status);
        client.assert(response.contentType.mimeType === "application/problem+json", "not problem+json");
    });
%}

