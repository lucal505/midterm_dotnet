Content-Type: application/json

{
  "bookedBy": "{{run}}-r7a",
  "startUtc": "2030-01-10T11:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 1
}

> {%
    client.test("409 problem+json", () => {
        client.assert(response.status === 409, "got " + response.status);
        client.assert(response.contentType.mimeType === "application/problem+json", "not problem+json");
    });
%}

