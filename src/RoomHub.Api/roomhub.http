############################################################################
# BOOKINGS: create / get
############################################################################

### 13. Create booking 10:00-12:00 -> 201 + Location + { id, roomId, status }
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "{{run}}-ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

> {%
    client.global.set("bookingId", response.body.id);
    client.test("201 Created with Location and body", () => {
        client.assert(response.status === 201, "got " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/bookings/" + response.body.id, "wrong Location");
        client.assert(response.body.roomId === client.global.get("roomId"), "wrong roomId");
        client.assert(response.body.status === "Active", "status should be Active");
    });
%}

### 14. Get booking -> 200 with all fields, UTC dates, status as text
GET {{baseUrl}}/api/bookings/{{bookingId}}

> {%
    client.test("200 with booking", () => {
        client.assert(response.status === 200, "got " + response.status);
        const b = response.body;
        client.assert(b.id === client.global.get("bookingId"), "wrong id");
        client.assert(b.roomId === client.global.get("roomId"), "wrong roomId");
        client.assert(b.bookedBy === client.global.get("run") + "-ana", "wrong bookedBy");
        client.assert(b.startUtc === "2030-01-10T10:00:00Z", "wrong startUtc: " + b.startUtc);
        client.assert(b.endUtc === "2030-01-10T12:00:00Z", "wrong endUtc: " + b.endUtc);
        client.assert(b.attendees === 4, "wrong attendees");
        client.assert(b.status === "Active", "wrong status");
    });
%}

### 15. Get missing booking -> 404 ProblemDetails
GET {{baseUrl}}/api/bookings/00000000-0000-0000-0000-000000000001

> {%
    client.test("404 problem+json", () => {
        client.assert(response.status === 404, "got " + response.status);
        client.assert(response.contentType.mimeType === "application/problem+json", "not problem+json");
    });
%}

### 16. Booking in a missing room with an invalid body -> 404 (before any validation)
POST {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001/bookings
Content-Type: application/json

{
  "bookedBy": "",
  "startUtc": "2020-01-10T12:00:00Z",
  "endUtc": "2020-01-10T10:00:00Z",
  "attendees": 0
}

> {%
    client.test("404 before validation", () => client.assert(response.status === 404, "got " + response.status));
%}

